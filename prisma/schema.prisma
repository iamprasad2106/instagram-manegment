datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String          @id @default(cuid())
  username          String          @unique
  fullName          String
  avatarUrl         String
  bio               String
  category          String
  website           String
  isVerified        Boolean         @default(false)
  followersCount    Int             @default(0)
  followingCount    Int             @default(0)
  postsCount        Int             @default(0)
  engagementRate    Float           @default(0.0)
  storyReach        Int             @default(0)
  profileViewsWeek  Int             @default(0)
  websiteClicksWeek Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  posts             Post[]
  reels             Reel[]
  comments          Comment[]
  scheduledPosts    ScheduledPost[]
  automationRules   AutomationRule[]
  notifications     Notification[]
}

model Post {
  id               String    @id @default(cuid())
  accountId        String
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mediaUrl         String
  carouselUrls     String?   // JSON array of image URLs
  mediaType        String    @default("image") // "image" | "carousel" | "video"
  caption          String
  likesCount       Int       @default(0)
  commentsCount    Int       @default(0)
  sharesCount      Int       @default(0)
  savesCount       Int       @default(0)
  reachCount       Int       @default(0)
  impressionsCount Int       @default(0)
  postedAt         DateTime  @default(now())
  status           String    @default("published") // "published" | "scheduled" | "draft" | "archived"
  scheduledFor     DateTime?
  hashtags         String    // JSON array of strings
  location         String?
  taggedUsers      String?   // JSON array of strings
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Reel {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  videoUrl         String
  thumbnailUrl     String
  caption          String
  viewsCount       Int      @default(0)
  likesCount       Int      @default(0)
  commentsCount    Int      @default(0)
  sharesCount      Int      @default(0)
  savesCount       Int      @default(0)
  watchTimeSeconds Int      @default(0)
  completionRate   Int      @default(0)
  audioTitle       String
  duration         String   @default("0:30")
  postedAt         DateTime @default(now())
  status           String   @default("published")
  viralityScore    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Comment {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  postId        String
  postThumbnail String
  postCaption   String
  username      String
  userAvatar    String
  userHandle    String
  text          String
  timeAgo       String   @default("Just now")
  likesCount    Int      @default(0)
  isLiked       Boolean  @default(false)
  sentiment     String   @default("neutral") // "positive" | "question" | "neutral" | "spam" | "negative"
  status        String   @default("unread") // "unread" | "replied" | "flagged" | "hidden"
  replyText     String?
  repliedAt     String?
  isPinned      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ScheduledPost {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type              String   @default("post") // "post" | "reel" | "story" | "carousel"
  mediaUrl          String
  carouselUrls      String?
  caption           String
  scheduledDateTime DateTime
  status            String   @default("scheduled") // "scheduled" | "draft" | "publishing" | "published"
  hashtags          String   // JSON array
  location          String?
  firstComment      String?
  audioTitle        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AutomationRule {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String
  triggerKeywords String   // JSON array of strings
  replyTemplate   String
  isActive        Boolean  @default(true)
  actionType      String   @default("reply_comment")
  executionCount  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title     String
  message   String
  timeAgo   String   @default("Just now")
  type      String   @default("system")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
